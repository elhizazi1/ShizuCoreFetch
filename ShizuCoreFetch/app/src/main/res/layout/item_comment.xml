<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="12dp">

    <!-- صورة المستخدم -->
    <ImageView
        android:id="@+id/ivCommentAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        tools:src="@tools:sample/avatars" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- القسم العلوي: الاسم وزر الرد -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- تم التعديل هنا: محاذاة النص للبداية وتحديد الاتجاه -->
            <TextView
                android:id="@+id/tvCommentUsername"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                tools:text="Jamal El Hizazi" />

            <TextView
                android:id="@+id/tvCommentReply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/comment_reply_button"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- نص التعليق (تم التعديل هنا أيضاً) -->
        <TextView
            android:id="@+id/tvCommentBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            tools:text="نص التعليق يظهر هنا" />

        <!-- القسم السفلي: التفاعلات وأزرار التعديل والحذف -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCommentReactions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                tools:text="👍 5  ❤️ 2" />

            <ImageView
                android:id="@+id/ivCommentAddReaction"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:padding="4dp"
                android:src="@drawable/ic_add_reaction"
                app:tint="@color/colorTextSecondary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvCommentEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/comment_edit_button"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvCommentDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/comment_delete_button"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="12sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
